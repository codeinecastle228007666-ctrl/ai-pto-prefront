# API
VITE_API_URL=/api
# Куда vite dev проксирует /api (бэк)
VITE_PROXY_TARGET=http://localhost:3000

# App
VITE_APP_NAME=AI-ПТО

# Mocks: false — работать с реальным бэком
VITE_USE_MOCKS=true

# Публичное демо на /demo (один прогон). false — скрыть CTA и редирект с /demo
VITE_PUBLIC_DEMO_ENABLED=false